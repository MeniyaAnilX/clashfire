rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // === ACCOUNTS ===
    // Doc ID = Free Fire UID directly
    // Anyone can read/write - redeem is manual so no strict validation needed
    match /accounts/{ffUid} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if false; // Nobody can delete accounts from client
    }

    // === SETTINGS (Global Config) ===
    // Read-only publicly - only update from Firebase Console
    match /settings/{settingId} {
      allow read: if true;
      allow write: if false;
    }

    // === REDEMPTIONS ===
    // Anyone can create and read redemption requests
    // Updates/deletes only from Firebase Console (manual process)
    match /redemptions/{redemptionId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if false;
    }

    // Block all other collections by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
